# ─────────────────────────────────────────────────────────────
# FSMS V2 — environment template. Copy to .env.local (never commit).
# All secrets live in environment variables ONLY (Phase 0 policy).
# ─────────────────────────────────────────────────────────────

# Supabase (O5: dev / staging / production projects are separate)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email provider — Resend (O5). Never expose service keys to the browser.
RESEND_API_KEY=
EMAIL_FROM="FSMS <noreply@example.com>"

# AI providers (Phase 21). Keys are server-side only.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Translation provider (O3). Optional; falls back to NoopProvider.
GOOGLE_TRANSLATE_API_KEY=

# Supabase Storage bucket for uploaded files (Phase 26, F20.1).
STORAGE_BUCKET=fsms-files

# Canonical app URL (O4). Used for links in email/notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth (Phase 8) ───────────────────────────────────────────
# AUTH_MODE: "supabase" (production) | "local" (dev-only harness).
# Defaults to "local" when NEXT_PUBLIC_SUPABASE_URL is empty, and the local
# path is hard-disabled in production builds.
AUTH_MODE=
# LOCAL-ONLY harness (never used in production):
LOCAL_DB_URL=postgres://fsms:fsms_dev@127.0.0.1:5432/fsms_v2
AUTH_LOCAL_SECRET=fsms-local-dev-secret-change-me
