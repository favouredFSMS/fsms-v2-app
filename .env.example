# ─────────────────────────────────────────────────────────────
# FSMS V2 — environment template. Copy to .env.local (never commit).
# All secrets live in environment variables ONLY (Phase 0 policy).
# Every value below is a PLACEHOLDER. Do not paste real credentials here.
# ─────────────────────────────────────────────────────────────

# ── Supabase (O5: dev / staging / production are separate projects) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email provider — Resend (O5). Never expose service keys to the browser. ──
RESEND_API_KEY=
EMAIL_FROM="FSMS <noreply@example.com>"

# ── AI providers (Phase 21). Keys are server-side only. ──
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Translation provider (O3). Optional; falls back to NoopProvider. ──
GOOGLE_TRANSLATE_API_KEY=

# ── Supabase Storage bucket for uploaded files (Phase 26, F20.1). ──
STORAGE_BUCKET=fsms-files

# ── Canonical app URL (O4). Used for links in email/notifications. ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth (Phase 8) ───────────────────────────────────────────
# AUTH_MODE: "supabase" (production) | "local" (dev-only harness).
# Defaults to "local" when NEXT_PUBLIC_SUPABASE_URL is empty, and the local
# path is hard-disabled in production builds.
AUTH_MODE=
# LOCAL-ONLY harness (never used in production):
LOCAL_DB_URL=postgres://fsms:fsms_dev@127.0.0.1:5432/fsms_v2
AUTH_LOCAL_SECRET=fsms-local-dev-secret-change-me

# ── Staging deployment (Phase 32) — project ref is public, not a secret ──
# Staging project "FSMS V2 Staging" (created by the owner). The ref appears in
# the project URL; secrets below stay in the secrets manager, never in files.
SUPABASE_STAGING_PROJECT_ID=arphhvgskwciljogosmf
# Staging API URL (derived from the ref — public):
NEXT_PUBLIC_SUPABASE_URL=https://arphhvgskwciljogosmf.supabase.co
# Staging anon key (public, per-project) — from Dashboard → Settings → API:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Staging DB connection string for migrations/seed + the integration suite.
# Copy the exact pooler URI from Dashboard → Settings → Database; the password
# is a SECRET and must never be committed or pasted (placeholder below):
STAGING_DB_URL=postgres://postgres:PLACEHOLDER@db.arphhvgskwciljogosmf.supabase.co:5432/postgres
# App's own staging host: Vercel (decided 2026-09-05). On staging, set the
# functional NEXT_PUBLIC_APP_URL (auth redirectTo resolves against it) to the
# deployed Vercel URL:
#   NEXT_PUBLIC_APP_URL=https://fsms-v2-staging.vercel.app
NEXT_PUBLIC_STAGING_URL=https://fsms-v2-staging.vercel.app
# Supabase CLI token for CI `db push` (secret — store as a CI secret only):
SUPABASE_ACCESS_TOKEN=
